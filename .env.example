# Client values are public and bundled in the app. Never put server secrets here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_WEB_ORIGIN=

# Leave unset in real builds. A build with no Supabase settings then shows
# "This app is not connected yet" instead of sample data. Set to true only to
# make a sample/demo build on purpose.
# EXPO_PUBLIC_ALLOW_DEMO=true

# Server/operator values: use environment variables or a password manager.
# Never prefix these with EXPO_PUBLIC_. Never commit filled environment files.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# CREWGRAIN_ADMIN_EMAIL=
# CREWGRAIN_ADMIN_EMPLOYEE_ID=
# CREWGRAIN_ADMIN_NAME=
# CREWGRAIN_ADMIN_PASSWORD=
# CREWGRAIN_FIRST_UNIT_NAME=

# Monitoring and push (all optional; real values live in EAS environment variables).
# EXPO_PUBLIC_APP_ENV=production        # production | preview
# EXPO_PUBLIC_SENTRY_DSN=               # public DSN from the Sentry project
# SENTRY_ORG=                           # build-time, source map upload
# SENTRY_PROJECT=                       # build-time, source map upload
# SENTRY_AUTH_TOKEN=                    # EAS secret ONLY, never in a file
# Edge Function secrets (supabase secrets set ...), never EXPO_PUBLIC_:
# EXPO_ACCESS_TOKEN=                    # only if Expo enhanced push security is on
